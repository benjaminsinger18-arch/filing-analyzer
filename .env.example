# SEC EDGAR requires a descriptive User-Agent with a contact address.
# Copy to .env.local and fill in your own name and email.
SEC_USER_AGENT="Your Name your-email@example.com"

# Optional: Alpha Vantage key for share prices (free tier: 25 requests/day). Falls back to Yahoo if unset.
ALPHAVANTAGE_API_KEY=""

# Optional: Finnhub key for provider market ratios (free at finnhub.io, 60 calls/min).
FINNHUB_API_KEY=""
